# ---------------------------------------------------------------------------
# gel-al-web — ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayın: cp .env.example .env.local
# ---------------------------------------------------------------------------

# NODE_ENV BURAYA YAZILMAZ.
# Next.js komuta göre kendisi ayarlar (next dev → development,
# next build → production). Elle yazıldığında üretim derlemesi development
# modunda çalışır, React'in iki derlemesi karışır ve derleme
# "Cannot read properties of null (reading 'useContext')" hatasıyla düşer.
# Bu hata sebebini hiç göstermez; saatler kaybettirir.

# --- Backend ---
# Müşteri sitesinin veriye ulaştığı tek adres. Canlıda: https://api.gelal.com
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
